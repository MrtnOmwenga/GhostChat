# Required: at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
MONGODB_URI=mongodb://localhost:27017/ghostchat
# Optional: enables shared presence and running several server instances
REDIS_URL=
PORT=5000
# Origins allowed to call the API with credentials (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
SESSION_HOURS=12
